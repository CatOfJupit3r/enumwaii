{
  "name": "enumwaii-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "premove api/enumwaii api/eslint-plugin-enumwaii && typedoc --options typedoc.enumwaii.json",
    "build": "pnpm api:generate && next build && node ../scripts/materialize-docs-markdown.mjs out && node ../scripts/check-docs-export.mjs out",
    "clean": "premove .next .source out api/enumwaii api/eslint-plugin-enumwaii",
    "dev": "pnpm --filter enumwaii build && pnpm api:generate && next dev",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@standard-schema/spec": "1.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "enumwaii": "workspace:*",
    "fumadocs-twoslash": "3.3.0",
    "postcss": "8.5.26",
    "premove": "4.0.0",
    "tailwindcss": "4.3.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-frontmatter": "1.3.1",
    "typedoc-plugin-markdown": "4.13.0",
    "twoslash": "0.3.9",
    "typescript": "6.0.3",
    "valibot": "1.4.2",
    "zod": "4.4.3"
  }
}
