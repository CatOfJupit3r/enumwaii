{
  "$schema": "https://typedoc.org/schema.json",
  "name": "eslint-plugin-enumwaii",
  "entryPoints": ["../packages/eslint-plugin-enumwaii/src/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "../packages/eslint-plugin-enumwaii/tsconfig.json",
  "out": "api/eslint-plugin-enumwaii",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-plugin-frontmatter",
    "./typedoc-frontmatter.mjs"
  ],
  "router": "member",
  "entryFileName": "index",
  "readme": "none",
  "hidePageTitle": true,
  "indexFormat": "table",
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "typeAliasPropertiesFormat": "table",
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "includeVersion": false,
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/CatOfJupit3r/enumwaii/blob/{gitRevision}/{path}#L{line}",
  "validation": {
    "invalidLink": true,
    "notDocumented": false,
    "notExported": true
  }
}
