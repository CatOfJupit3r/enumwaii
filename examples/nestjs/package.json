{
  "name": "@enumwaii/example-nestjs-mongoose",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm run db:up",
    "dev": "pnpm run build && pnpm run start",
    "build": "swc src -d dist --strip-leading-paths --delete-dir-on-start",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "enumwaii": "file:../../packages/enumwaii",
    "mongoose": "9.11.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
