{
  "name": "enumwaii-workspace",
  "private": true,
  "type": "module",
  "homepage": "https://catofjupit3r.github.io/enumwaii/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatOfJupit3r/enumwaii.git"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-dependency-pins.mjs",
    "build": "pnpm --recursive --if-present run build",
    "build:core": "pnpm --filter enumwaii --filter eslint-plugin-enumwaii run build",
    "clean": "pnpm --recursive --if-present run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:core": "prettier --check .github .changeset packages scripts package.json pnpm-workspace.yaml tsconfig.json README.md SECURITY.md CONTRIBUTING.md CODE_OF_CONDUCT.md SUPPORT.md",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:core": "oxlint --type-aware --deny-warnings packages scripts",
    "test": "pnpm --recursive --if-present run test",
    "test:core": "pnpm --filter enumwaii --filter eslint-plugin-enumwaii run test",
    "test:pins": "node scripts/check-dependency-pins.mjs",
    "test:runtimes": "pnpm --filter @enumwaii/example-hono-drizzle test:runtimes",
    "test:types": "pnpm --recursive --if-present run test:types",
    "test:types:core": "pnpm --filter enumwaii --filter eslint-plugin-enumwaii run test:types",
    "test:docs": "node scripts/check-api-jsdoc.mjs",
    "test:build": "pnpm --recursive --if-present run test:build",
    "test:build:core": "pnpm --filter enumwaii --filter eslint-plugin-enumwaii run test:build",
    "test:skills": "pnpm --filter enumwaii exec intent validate skills --check",
    "skills:stale": "pnpm --filter enumwaii exec intent stale",
    "docs:api": "pnpm --filter enumwaii-docs api:generate",
    "docs:build": "pnpm --filter enumwaii-docs build",
    "docs:dev": "pnpm --filter enumwaii-docs dev",
    "check:core": "pnpm format:check:core && pnpm test:pins && pnpm lint:core && pnpm test:core && pnpm test:types:core && pnpm test:skills && pnpm build:core && pnpm test:docs && pnpm test:build:core",
    "check": "pnpm format:check && pnpm test:pins && pnpm lint && pnpm test && pnpm test:types && pnpm test:skills && pnpm build && pnpm test:docs && pnpm test:build",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@types/node": "24.13.3",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "premove": "4.0.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
